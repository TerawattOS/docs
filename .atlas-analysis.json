  "keyFeatures": [
    "Real-time portfolio-wide asset monitoring dashboard",
    "Multi-OEM integration via vendor-agnostic edge gateway",
    "Automated fault detection and AI-powered diagnostics",
    "Work order management with mobile field app",
    "TerawattEDGE IoT dongle with sub-second telemetry and offline buffering",
    "Battery dispatch optimization and remote system control",
    "Automated investor and ESG reporting",
    "REST API and webhooks for EMS/SCADA integration",
    "Support for Modbus RTU/TCP, SunSpec, DNP3, IEC 61850, and OCPP protocols",
    "Scalable to 10,000+ concurrent distributed assets"
  ],
  "publicApiSurface": [
    "REST API for telemetry data ingestion and retrieval",
    "Webhooks for EMS/SCADA integration",
    "TerawattEDGE provisioning via QR code and mobile app",
    "Modbus RTU/TCP protocol support",
    "SunSpec protocol support",
    "DNP3 protocol support",
    "IEC 61850 protocol support",
    "OCPP protocol support",
    "Battery dispatch schedule configuration",
    "Alert threshold configuration",
    "Role-based access control (RBAC)",
    "Automated report generation (PDF and live web)"
  ]
